# Copy this file to .env.local and fill in ONE of the following to enable live
# Claude-powered analysis. Without either, the app automatically falls back to a
# deterministic rule-based scorer so the demo always works.

# Option A: Vercel AI Gateway key (recommended, default per Vercel guidance)
AI_GATEWAY_API_KEY=

# Option B: Direct Anthropic key (used only if you wire @ai-sdk/anthropic directly)
ANTHROPIC_API_KEY=
